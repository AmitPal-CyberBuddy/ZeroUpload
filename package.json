{
  "name": "zeroupload",
  "private": true,
  "version": "0.1.0",
  "description": "Every file tool you need, nothing leaves your browser. A privacy-first, browser-only file utility platform.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs && node scripts/csp.mjs && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "tsc -b",
    "measure": "vite --config scripts/measure/vite.config.ts",
    "weigh": "node scripts/weigh.mjs",
    "verify": "npm run build && npm test && npm run test:dom && npm run weigh",
    "test:browser-layout": "node scripts/check-responsive.mjs",
    "test:browser-pdf-editor": "node scripts/check-pdf-editor.mjs",
    "test:browser-inspector": "node scripts/check-inspector-compare.mjs",
    "test:browser-xlsx": "node scripts/check-xlsx-csv.mjs",
    "baseline": "node scripts/baseline.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@zip.js/zip.js": "^2.24.0",
    "fflate": "^0.8.3",
    "office-crypto": "^0.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
